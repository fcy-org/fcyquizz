# Destino principal do CRM. Use a URL completa com o token na hospedagem.
# Se não estiver definido, WEBHOOK_SUPABASE_URL será usado como CRM principal.
WEBHOOK_LEADS_URL=https://mpajmwwwexxnrsyocppb.supabase.co/functions/v1/api-webhook-receiver?token=SEU_TOKEN_DO_WEBHOOK

# Token privado da API de Conversões. Não use NEXT_PUBLIC_ neste token.
META_ACCESS_TOKEN=SEU_TOKEN_DA_META
NEXT_PUBLIC_META_PIXEL_ID=1014610764961858
META_GRAPH_API_VERSION=v26.0

# Opcional: preencha somente para enviar eventos ao painel de testes da Meta.
META_TEST_EVENT_CODE=

# CRM principal quando WEBHOOK_LEADS_URL não estiver definido.
# Se ambos estiverem definidos e forem diferentes, este será um destino secundário.
WEBHOOK_SUPABASE_URL=
