# Destino principal do CRM (Umbrella). Se não estiver definido, o código usa este mesmo webhook da Umbrella.
WEBHOOK_LEADS_URL=https://crm-api.umbrellaecosystem.com.br/api/v1/webhooks/in/d800b8c1-550a-418a-b9da-beffa7f70273

# Token privado da API de Conversões. Não use NEXT_PUBLIC_ neste token.
META_ACCESS_TOKEN=SEU_TOKEN_DA_META
NEXT_PUBLIC_META_PIXEL_ID=1014610764961858
META_GRAPH_API_VERSION=v26.0

# Opcional: preencha somente para enviar eventos ao painel de testes da Meta.
META_TEST_EVENT_CODE=

# Opcional: destino secundário (ex.: CRM antigo no Supabase). Falhas aqui não bloqueiam o lead.
WEBHOOK_SUPABASE_URL=


# Opcional: segundo webhook da Umbrella. Recebe todos os leads; falhas aqui não bloqueiam o lead.
WEBHOOK_UMBRELLA_EXTRA_URL=
